# Example terraform.tfvars - Copy this to terraform.tfvars and update values

aws_region = "us-east-1"
environment = "prod"

# VPC Configuration
vpc_cidr             = "10.0.0.0/16"
availability_zones   = ["us-east-1a", "us-east-1b"]
public_subnet_cidrs  = ["10.0.1.0/24", "10.0.2.0/24"]
private_subnet_cidrs = ["10.0.10.0/24", "10.0.11.0/24"]

# Container Configuration
# TODO: Update with your ECR image URI
container_image = "YOUR_AWS_ACCOUNT_ID.dkr.ecr.us-east-1.amazonaws.com/ecs-pratice:latest"
container_port  = 8080
container_cpu   = 256
container_memory = 512

# Scaling Configuration
desired_count = 2
max_capacity  = 4

# Logging
log_retention_days = 7

# Health Check
health_check_path = "/health"

# Environment Variables
container_environment_variables = [
  {
    name  = "ENV"
    value = "production"
  }
]
